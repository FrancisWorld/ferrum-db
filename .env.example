# Copy to .env to override the defaults used by docker-compose.yml.
# The password is required. Generate one instead of committing it:
#   export FERRUM_REQUIREPASS=$(openssl rand -hex 16)
FERRUM_HOST_PORT=6380
FERRUM_AOF_FSYNC=everysec
FERRUM_MAXMEMORY=256mb
# FERRUM_REQUIREPASS=<generate one, do not commit>
RUST_LOG=info
